# Praktikum 4 - Operator Penugasan

# 1. Menyimpan poin awal
poin = 100
print("Nilai awal:", poin)

# 2. Menambahkan 25 poin
poin += 25
print("Setelah ditambah 25:", poin)

# 3. Mengurangi 10 poin
poin -= 10
print("Setelah dikurangi 10:", poin)

# 4. Mengalikan poin dengan 2
poin *= 2
print("Setelah dikalikan 2:", poin)

# 5. Membagi poin dengan 2
poin /= 2
print("Setelah dibagi 2:", poin)
