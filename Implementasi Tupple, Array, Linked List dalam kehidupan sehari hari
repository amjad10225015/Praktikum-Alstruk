# Program Linked List Antrean Parkir

class Node:
    def __init__(self, kendaraan):
        self.kendaraan = kendaraan
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None

    def tambah(self, kendaraan):
        node_baru = Node(kendaraan)

        if self.head is None:
            self.head = node_baru
        else:
            sekarang = self.head

            while sekarang.next:
                sekarang = sekarang.next

            sekarang.next = node_baru

    def tampilkan(self):
        sekarang = self.head

        print("DAFTAR KENDARAAN PARKIR")

        while sekarang:
            print(sekarang.kendaraan)
            sekarang = sekarang.next

